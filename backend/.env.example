# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@[host].supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_PASSWORD=replace-with-a-strong-password

# Required in PRODUCTION (NODE_ENV=production): the backend REFUSES TO BOOT
# without it. Used to email student login OTP codes via Resend. In dev, if this
# is unset the app still boots and OTP codes are logged to the server console.
RESEND_API_KEY=re_...your-resend-api-key...

# From-address for all outgoing mail. MUST use a Resend-verified domain or
# Resend returns 403 for any recipient other than the account owner. If unset,
# falls back to the Resend sandbox address (delivers only to the account owner).
MAIL_FROM=DnA Club IITK <no-reply@dnaiitk.site>

# ── Supabase Storage (set both together, or omit both to use local disk in dev) ─
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
SUPABASE_STORAGE_BUCKET=dna-media

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed CORS origins (never use * in production)
CORS_ORIGINS=https://your-frontend.vercel.app
# Base URL used by local storage provider to build public file URLs
API_BASE_URL=https://your-api.onrender.com
# Optional passcode that seeds the public meet scheduler. If unset, the feature
# stays disabled with no passcode until an admin configures one via /settings.
PUBLIC_MEET_PASSCODE=
# Database TLS. Certificate verification is ON by default. Set to false only for
# local/dev databases with self-signed certs. Provide a custom CA via DB_SSL_CA.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# Shared secret for POST /api/internal/tick (drains the quota-gated mail queue
# and sends event reminders due in the next ~65 min). Required for that
# endpoint to work — it 503s without it. On Render's free tier the web service
# spins down when idle, so there's no in-process scheduler; instead, an
# external free scheduler (e.g. cron-job.org) should POST to this endpoint
# every ~10 minutes with header "X-Tick-Secret: <this value>". Generate with:
# openssl rand -hex 32
INTERNAL_TICK_SECRET=

# ── Tests (npm test, see tests/) ──────────────────────────────────────────────
# `npm test` runs integration tests against a REAL Postgres database — never
# against DATABASE_URL above. Point this at a disposable local/CI database;
# tests call initSchema() then TRUNCATE the tables they touch after every test.
# Create one locally with: psql -U youruser -d postgres -c "CREATE DATABASE dna_club_test;"
# Defaults to postgresql://localhost:5432/dna_club_test if unset.
TEST_DATABASE_URL=postgresql://localhost:5432/dna_club_test
