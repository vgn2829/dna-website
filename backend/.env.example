# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@[host].supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Supabase Storage (set both together, or omit both to use local disk in dev) ─
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
SUPABASE_STORAGE_BUCKET=dna-media

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed CORS origins (never use * in production)
CORS_ORIGINS=https://your-frontend.vercel.app
# Base URL used by local storage provider to build public file URLs
API_BASE_URL=https://your-api.onrender.com
# Optional passcode that seeds the public meet scheduler. If unset, the feature
# stays disabled with no passcode until an admin configures one via /settings.
PUBLIC_MEET_PASSCODE=
