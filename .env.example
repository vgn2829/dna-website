# Copy to .env and fill in your values before running docker compose
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_PASSWORD=change-me-in-production
CORS_ORIGINS=https://yourdomain.com
PORT=80

# Required in production: the backend refuses to boot without it (student login
# OTP email via Resend). In dev, if unset, OTP codes are logged to the console.
RESEND_API_KEY=re_...your-resend-api-key...

# From-address for outgoing mail. Must use a Resend-verified domain, or Resend
# returns 403 for any recipient other than the account owner. If unset, falls
# back to the Resend sandbox address (delivers only to the account owner).
MAIL_FROM=DnA Club IITK <no-reply@dnaiitk.site>


# ── Optional ──────────────────────────────────────────────────────────────────
# Seeds the public meet scheduler passcode; if unset the feature stays disabled
# until an admin configures one via /settings.
PUBLIC_MEET_PASSCODE=
# Database TLS. Verification is ON by default; set false only for self-signed
# dev DBs. Provide a custom CA via DB_SSL_CA.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
