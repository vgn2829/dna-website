{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/__prod_host_smoke_test__",
      "has": [
        { "type": "host", "value": "dna-website-two.vercel.app" }
      ],
      "destination": "https://example.com/prod-host-matched-smoke-test",
      "permanent": false
    },
    {
      "source": "/__wildcard_smoke_test__/:path*",
      "has": [
        { "type": "host", "value": "dna-website-two.vercel.app" }
      ],
      "destination": "https://example.com/wildcard-matched-smoke-test/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "dna-website-two.vercel.app" }
      ],
      "destination": "https://www.dnaiitk.site/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "dna-website-vgn2829s-projects.vercel.app" }
      ],
      "destination": "https://www.dnaiitk.site/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "dna-website-git-main-vgn2829s-projects.vercel.app" }
      ],
      "destination": "https://www.dnaiitk.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
